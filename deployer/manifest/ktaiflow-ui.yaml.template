apiVersion: apps/v1
kind: Deployment
metadata:
  name: $name-ktaiflow-ui
  namespace: $namespace
  labels:
    app.kubernetes.io/name: "$name"
    app.kubernetes.io/component: ktaiflow-ui
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ktaiflow-ui
      app.kubernetes.io/name: "$name"
  template:
    metadata:
      labels:
        app: ktaiflow-ui
        app.kubernetes.io/name: "$name"
        app.kubernetes.io/component: ktaiflow-ui
    spec:
      containers:
        - name: ktaiflow-ui
          image: $ktaiflowUiImage
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 80
          resources:
            requests:
              cpu: "50m"
              memory: "128Mi"
            limits:
              cpu: "250m"
              memory: "256Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: $name-ktaiflow-ui-svc
  namespace: $namespace
  labels:
    app.kubernetes.io/name: "$name"
spec:
  type: ClusterIP
  ports:
    - port: 80
      targetPort: 80
  selector:
    app: ktaiflow-ui
    app.kubernetes.io/name: "$name"
